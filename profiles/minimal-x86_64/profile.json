{
  "schema_version": 1,
  "profile_id": "minimal-x86_64",
  "status": "experimental-specification",
  "target": {
    "architecture": "x86_64",
    "firmware": [
      "uefi"
    ],
    "libc": "glibc"
  },
  "bootstrap": {
    "distribution": "fedora",
    "release": "45",
    "package_manager": "dnf",
    "image_builder_candidate": "lorax-livemedia-creator",
    "purpose": "technology-preview-only",
    "independent_deku_rootfs": false
  },
  "boot_target": {
    "stage": "console",
    "kernel_source": "upstream-linux",
    "initramfs": "dracut",
    "service_manager": "systemd",
    "desktop": "deferred-until-console-boot-passes"
  },
  "package_selection": [
    "NetworkManager",
    "bash",
    "coreutils",
    "dracut-config-generic",
    "dracut-live",
    "dracut-network",
    "efibootmgr",
    "grub2-efi-x64",
    "grub2-efi-x64-cdboot",
    "grub2-efi-x64-modules",
    "grub2-pc",
    "grub2-pc-modules",
    "grub2-tools",
    "grub2-tools-extra",
    "iproute",
    "iputils",
    "kernel",
    "kernel-modules",
    "livesys-scripts",
    "shim-x64",
    "systemd",
    "tar",
    "util-linux"
  ],
  "integrity": {
    "require_immutable_inputs": true,
    "record_source_and_package_manifest": true,
    "record_artifact_sha256": true,
    "require_vm_boot_evidence": true
  },
  "limitations": [
    "This is an experimental Fedora-based technology-preview input, not a validated ISO.",
    "It does not produce an ISO by itself; the Lorax workflow is a separate build step.",
    "It uses upstream Fedora packages and does not prove that Deku has an independent root filesystem.",
    "It does not prove that deku-pkg can install or update a system."
  ]
}
